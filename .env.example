# ==============================================================================
# Gemini Audio Transcription Engine Configuration
# ==============================================================================
# Copy this file to .env and adjust your settings:
#   copy .env.example .env (Windows)
#   cp .env.example .env (Linux/macOS)

# ------------------------------------------------------------------------------
# 1. API Credentials (Required)
# ------------------------------------------------------------------------------
# Get your Gemini API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. AI Model Selection (Default: Gemini 3.7 Flash)
# ------------------------------------------------------------------------------
# Recommended models:
#   - gemini-3.7-flash      (Latest flagship, fast, smart, high quality verbatim)
#   - gemini-flash-latest   (Always points to latest stable flash model)
#   - gemini-pro-latest     (Highest complex reasoning capability)
GEMINI_MODEL=gemini-3.7-flash

# ------------------------------------------------------------------------------
# 3. Audio Slicing (Smart FFmpeg Chunking)
# ------------------------------------------------------------------------------
# Duration of each slice in minutes. Files longer than this will be automatically
# sliced into parts via FFmpeg (Default: 10). Set to 0 to disable slicing.
CHUNK_MINUTES=10

# ------------------------------------------------------------------------------
# 4. Language & Prompt Settings
# ------------------------------------------------------------------------------
# Target language for verbatim transcription (e.g. Gujarati, Hindi, English)
LANGUAGE=Gujarati script (ગુજરાતી લિપિ)

# Interval in minutes for embedding timestamps / minute markers (e.g. 2, 5).
# Set to 0 to disable timestamps.
TIMESTAMP_INTERVAL=2

# Optional additional instructions for the transcription prompt
CUSTOM_INSTRUCTIONS=

# ------------------------------------------------------------------------------
# 5. Output & File Management
# ------------------------------------------------------------------------------
# Directory where generated Word (.docx) documents are saved.
# Leave blank to save in the same folder as the input audio files.
OUTPUT_DIR=

# Also save plain text (.txt) transcript alongside the Word .docx file (true / false)
SAVE_TXT=false

# Keep local temporary sliced audio files and checkpoints instead of auto-cleaning (true / false)
KEEP_CHUNKS=false

# ------------------------------------------------------------------------------
# 6. Resilience & Retry Budget
# ------------------------------------------------------------------------------
# Maximum wait budget in minutes to retry on temporary API demand spikes (503/pause)
MAX_RETRY_MINUTES=30

# ------------------------------------------------------------------------------
# 7. API Credit & Budget Tracking (Optional)
# ------------------------------------------------------------------------------
# Set your starting Google AI Studio credit balance in USD (e.g. 50.00 or 10.00).
# The run summary will automatically track starting balance, run cost, and remaining credit.
STARTING_BALANCE=


